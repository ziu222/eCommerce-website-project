generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  shop
  admin
}

enum AdminRole {
  super_admin
  pm
  ba
  hr
  staff
  support
}

enum ShopStatus {
  pending
  active
  suspended
}

enum ProductStatus {
  pending
  approved
  limited
  review
  rejected
  suspended
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  wallet
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum CouponType {
  percent
  fixed
}

enum WalletTxType {
  topup
  payment
  refund
}

model User {
  id              Int         @id @default(autoincrement())
  name            String
  username        String      @unique
  email           String      @unique
  passwordHash    String
  role            Role
  adminRole       AdminRole?
  status          String      @default("active")
  avatar          String?
  coverPhoto      String?
  shopName        String?
  shopDescription String?
  shopAddress     String?
  shopPhone       String?
  shopAvatar      String?
  shopStatus      ShopStatus?
  walletBalance   Decimal     @default(0) @db.Decimal(12, 2)
  /// bumped by "sign out everywhere": tokens carrying an older number stop working
  tokenVersion    Int         @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())

  products           Product[]
  ordersAsCustomer   Order[]             @relation("OrderCustomer")
  ordersAsShop       Order[]             @relation("OrderShop")
  coupons            Coupon[]
  walletTransactions WalletTransaction[]
  notificationReads  NotificationRead[]
  supportThreads     SupportThread[]     @relation("ThreadCustomer")
  assignedThreads    SupportThread[]     @relation("ThreadAgent")
  addresses          Address[]
  wishlist           WishlistItem[]
  productReports     ProductReport[]
}

model Product {
  id                Int           @id @default(autoincrement())
  shopId            Int
  shop              User          @relation(fields: [shopId], references: [id])
  name              String
  price             Decimal       @db.Decimal(12, 2)
  oldPrice          Decimal?      @db.Decimal(12, 2)
  imageUrl          String
  category          String
  rating            Float         @default(0)
  reviewCount       Int           @default(0)
  stock             Int           @default(0)
  description       String        @default("")
  specs             Json?
  adminStatus       ProductStatus @default(pending)
  adminNote         String        @default("")
  reviewedBy        String?
  reviewedAt        DateTime?
  /// 1 while the product is demoted (limited); the catalogue lists it last
  rankPenalty       Int           @default(0)
  /// approved by the backup standard while the AI was down; the AI checks it again later
  provisional       Boolean       @default(false)
  /// latest reasons from the automatic checks, shown to the shop
  moderationReasons Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderItems    OrderItem[]
  wishlistedBy  WishlistItem[]
  moderationJob ModerationJob?
  checks        ModerationCheck[]
  flags         ProductFlag[]
  reports       ProductReport[]

  @@index([adminStatus, category, rankPenalty])
  @@index([shopId])
}

model Order {
  id            Int           @id @default(autoincrement())
  customerId    Int
  customer      User          @relation("OrderCustomer", fields: [customerId], references: [id])
  shopId        Int
  shop          User          @relation("OrderShop", fields: [shopId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  couponCode    String?
  /// where the order goes, copied from the address book at checkout so later edits do not change it
  shipName      String?
  shipPhone     String?
  shipAddress   String?
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(pending)
  createdAt     DateTime      @default(now())

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([customerId])
  @@index([shopId, status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Decimal @db.Decimal(12, 2)
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String
  changedAt DateTime    @default(now())
}

model Coupon {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  type       CouponType
  value      Decimal    @db.Decimal(12, 2)
  minOrder   Decimal    @default(0) @db.Decimal(12, 2)
  usageLimit Int        @default(0)
  usedCount  Int        @default(0)
  expiresAt  DateTime?
  isActive   Boolean    @default(true)
  shopId     Int?
  shop       User?      @relation(fields: [shopId], references: [id])
  createdAt  DateTime   @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  targetRole Role?
  targetId   Int?
  orderId    Int?
  type       String
  title      String
  message    String
  sentBy     String
  source     String   @default("manual")
  batchId    String?
  createdAt  DateTime @default(now())

  reads NotificationRead[]

  @@index([targetRole, targetId])
}

model NotificationRead {
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
}

model WalletTransaction {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  type         WalletTxType
  amount       Decimal      @db.Decimal(12, 2)
  balanceAfter Decimal      @db.Decimal(12, 2)
  orderId      Int?
  gateway      String?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

// Support policies the assistant answers from. searchText is the folded (lowercase, accent-free) title + body;
// search is generated from it by the migration, so it is never written by the app.
model PolicyChunk {
  id         Int                      @id @default(autoincrement())
  slug       String                   @unique
  title      String
  body       String
  searchText String
  search     Unsupported("tsvector")?

  @@index([search], type: Gin)
}

enum SupportStatus {
  open // waiting for staff
  answered // staff replied, waiting for the customer
  closed
}

enum SupportAuthor {
  customer
  agent
}

// A customer's conversation with the support staff. The bot chat before it is kept as botTranscript for context.
model SupportThread {
  id                    Int              @id @default(autoincrement())
  customerId            Int
  customer              User             @relation("ThreadCustomer", fields: [customerId], references: [id])
  assignedToId          Int?
  assignedTo            User?            @relation("ThreadAgent", fields: [assignedToId], references: [id])
  subject               String
  status                SupportStatus    @default(open)
  botTranscript         String?
  customerReadMessageId Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now())
  messages              SupportMessage[]

  @@index([status, updatedAt])
  @@index([customerId])
}

model SupportMessage {
  id         Int           @id @default(autoincrement())
  threadId   Int
  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorType SupportAuthor
  authorId   Int?
  body       String
  createdAt  DateTime      @default(now())

  @@index([threadId, id])
}

/// A customer's saved delivery addresses; one of them can be the default.
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("")
  recipient String
  phone     String
  line1     String
  ward      String   @default("")
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Products a customer saved for later.
model WishlistItem {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ---- listing moderation (docs/superpowers/specs/2026-10-12-listing-moderation-design.md)

enum ModerationLayer {
  rules
  ai
  fallback
  admin
}

enum FlagSource {
  rules
  ai
  report
  fallback
}

enum FlagStatus {
  open
  dismissed
  minor
  violation
  severe
}

enum ReportReason {
  counterfeit
  prohibited
  misleading
  offplatform
  other
}

enum KeywordSeverity {
  block
  flag
}

/// A product waiting for the AI check; the table is the queue.
model ModerationJob {
  productId     Int       @id
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  trigger       String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  firstQueuedAt DateTime  @default(now())

  @@index([nextAttemptAt])
}

/// One decision by one layer, kept for audit and AI spend.
model ModerationCheck {
  id           Int             @id @default(autoincrement())
  productId    Int
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  layer        ModerationLayer
  outcome      String
  reasons      Json
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costMicros   Int?
  latencyMs    Int?
  decidedBy    String?
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@index([layer, createdAt])
}

/// A case in the admin queue. At most one open flag per product (partial unique index in the migration).
model ProductFlag {
  id        Int        @id @default(autoincrement())
  productId Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    FlagSource
  reasons   Json
  status    FlagStatus @default(open)
  note      String     @default("")
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
}

model ProductReport {
  id         Int          @id @default(autoincrement())
  productId  Int
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  note       String       @default("")
  createdAt  DateTime     @default(now())

  @@unique([productId, reporterId])
}

model BannedKeyword {
  id        Int             @id @default(autoincrement())
  /// stored folded: lower case, no accents
  phrase    String          @unique
  severity  KeywordSeverity
  createdBy String
  createdAt DateTime        @default(now())
}

model ModerationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
